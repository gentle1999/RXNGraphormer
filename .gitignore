# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# PyPI configuration file
.pypirc

# Local Python/runtime selectors
.python-version

# Development-only environment overlays.
# Only envs/README.md and the supported preprocessing environment manifest are tracked.
envs/*
!envs/README.md
!envs/preprocess/
envs/preprocess/*
!envs/preprocess/pyproject.toml

# Development/test training configs.
# Keep only the supported example and reproduction TOML configs.
config_toml/**
!config_toml/
!config_toml/buchwald_hartwig_parameters.toml
!config_toml/bh_scratch_reproduce.toml

# Development/experiment scripts.
# Keep only stable operational utilities used by supported environment docs.
scripts/**
!scripts/
!scripts/rxngraphormer_pipeline.sh
!scripts/convert_pt_to_safetensors.py
!scripts/run_pretrain_graphnorm_preprocess.sh
!scripts/full_df/
scripts/full_df/**
!scripts/full_df/create_initial_combo_kfold_splits.py
!scripts/full_df/plot_initial_combo_projection.py
!scripts/reproduce/
!scripts/reproduce/check_environment.py
!scripts/reproduce/figshare_assets.py


# Development/experiment docs.
# Keep only supported environment documentation.
docs/**
!docs/
!docs/environments.md
!docs/model_engineering_plan.md

# Temporary and run output folders
tmp/
temp/
.tmp/
.codex-tmp/
logs/
save/
experiments/
reports/
rxn_emb_tmp/
runs/
lightning_logs/
wandb/

