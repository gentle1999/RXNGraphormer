*.pth
*.ckpt
*.safetensors
*.onnx
events.out.tfevents*

# Model/checkpoint artifacts. Existing tracked docs remain tracked.
model_path/**

# Dataset artifacts. Existing tracked docs remain tracked.
dataset/**

